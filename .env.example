PORT=5000
DATABASE_URL=postgresql://user:password@localhost:5432/comic_db
NODE_ENV=production

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:5000

BETTER_AUTH_SECRET=your_auth_secret_key

# Admin Credentials for Seeding
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@genztoon.com
ADMIN_PASSWORD=password123

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
REDIS_URL=redis://localhost:6379

NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Site Configuration Defaults (Instant 0ms inlined fallback)
NEXT_PUBLIC_APP_NAME="Comic BD"
NEXT_PUBLIC_APP_TAGLINE="Read Trending Webtoons, Manga & Comics"
NEXT_PUBLIC_APP_LOGO_URL=""
NEXT_PUBLIC_HERO_HEADLINE="Discover Unlimited Stories & Comics"
NEXT_PUBLIC_HERO_SUBTITLE="Read high quality manhwa, manga and manhua translated with lightning speed."
NEXT_PUBLIC_DISCORD_URL="https://discord.gg"
NEXT_PUBLIC_TWITTER_URL="https://twitter.com"

# Google AdSense Client
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX

# Email Service Configuration (EmailJS REST API)
# In production, set your EmailJS credentials:
EMAILJS_SERVICE_ID=service_xxxxxxx
EMAILJS_TEMPLATE_ID=template_xxxxxxx
EMAILJS_PUBLIC_KEY=your_emailjs_public_key
EMAILJS_PRIVATE_KEY=your_emailjs_private_key_optional
EMAILJS_RESET_TEMPLATE_ID=template_reset_xxxx
EMAILJS_VERIFY_TEMPLATE_ID=template_verify_xxxx

# Fallback Email (Resend API)
RESEND_API_KEY=
EMAIL_FROM="Comic BD <no-reply@comicbd.com>"

# Render 24/7 Keep-Alive (Prevents free tier from going into sleep mode)
# Render automatically injects RENDER_EXTERNAL_URL in production. You can also specify KEEP_ALIVE_URL manually.
# KEEP_ALIVE_URL=https://your-service-name.onrender.com
# KEEP_ALIVE_INTERVAL_MINUTES=10
# AUTO_PING_ENABLED=true

