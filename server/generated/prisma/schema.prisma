datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
  output   = "../server/generated/prisma"
}

enum Role {
  user
  creator
  moderator
  admin
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum TransactionType {
  EARN_AD
  BUY_CHAPTER
  BUY_POINTS
  WITHDRAWAL
  REFERRAL_BONUS
  REVENUE_SHARE
  REVENUE_SHARE_REVERSAL
  WITHDRAWAL_REFUND
}

enum QualityTier {
  BOUNCED
  QUALIFIED
  ENGAGED
  COMPLETED
}

enum DistributionStatus {
  COMPLETED
  REVERTED
}

enum SeriesType {
  MANHWA
  MANGA
  MANHUA
  COMIC
}

enum SeriesStatus {
  ONGOING
  COMPLETED
  HIATUS
  DROPPED
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReportStatus {
  PENDING
  RESOLVED
  DISMISSED
}

model User {
  id            String    @id @default(uuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  role          Role      @default(user)
  banned        Boolean   @default(false)
  banReason     String?
  banExpires    DateTime?
  points        Int       @default(0)

  transactionsFrozen Boolean   @default(false)
  mutedUntil         DateTime?
  referralCode       String?   @unique @default(uuid())
  referredById       String?
  referredBy         User?     @relation("Referrals", fields: [referredById], references: [id])
  referrals          User[]    @relation("Referrals")

  dailyAdViews        Int      @default(0)
  dailyAdPointsEarned Int      @default(0)
  lastAdWatchDate     DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions          Session[]
  accounts          Account[]
  bookmarks         Bookmark[]
  history           History[]
  pointTransactions PointTransaction[]
  chapterPurchases  ChapterPurchase[]
  payments          Payment[]

  creatorProfile              CreatorProfile?
  seriesApplications          SeriesApplication[]
  withdrawals                 WithdrawalRequest[]
  comments                    Comment[]
  reviews                     Review[]
  reports                     Report[]
  featuredRequests            FeaturedRequest[]
  chatMessages                ChatMessage[]
  creatorPosts                CreatorPost[]
  auditLogs                   AuditLog[]
  promoRedemptions            PromoCodeRedemption[]
  createdPromoCodes           PromoCode[]
  chapterReadEvents           ChapterReadEvent[]
  revenueDistributionsCreated RevenueDistributionRun[] @relation("AdminDistributionRuns")

  @@map("user")
}

model CreatorProfile {
  id              String  @id @default(uuid())
  userId          String  @unique
  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  channelName     String
  description     String?
  bannerUrl       String?
  profileImage    String?
  totalEarnings   Int     @default(0)
  withdrawnAmount Int     @default(0)

  series              Series[]
  readEvents          ChapterReadEvent[]
  distributionPayouts RevenueDistributionPayout[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("creator_profile")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

model Series {
  id           String          @id @default(uuid())
  creatorId    String?
  creator      CreatorProfile? @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  title        String
  slug         String          @unique
  altTitles    String?
  description  String?
  coverUrl     String?
  bgUrl        String?
  type         SeriesType      @default(MANHWA)
  status       SeriesStatus    @default(ONGOING)
  rating       Float           @default(0.0)
  favorites    Int             @default(0)
  totalViews   Int             @default(0)
  isPinned     Boolean         @default(false)
  isHidden     Boolean         @default(false)
  hiddenReason String?
  discount     String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  genres           Genre[]
  chapters         Chapter[]
  bookmarks        Bookmark[]
  history          History[]
  featured         FeaturedSeries?
  reviews          Review[]
  reports          Report[]
  featuredRequests FeaturedRequest[]
  readEvents       ChapterReadEvent[]

  @@index([isHidden, status])
  @@index([totalViews(sort: Desc)])
  @@index([rating(sort: Desc)])
  @@index([updatedAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@index([creatorId])
  @@map("series")
}

model SeriesApplication {
  id          String            @id @default(uuid())
  creatorId   String
  creator     User              @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  title       String
  description String?
  status      ApplicationStatus @default(PENDING)
  notes       String? // Mod/Admin feedback
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([status, createdAt(sort: Desc)])
  @@index([creatorId])
  @@map("series_application")
}

model FeaturedSeries {
  id        String   @id @default(uuid())
  seriesId  String   @unique
  series    Series   @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@map("featured_series")
}

model SiteConfig {
  id             String  @id @default("global")
  appName        String  @default("Comic BD")
  appTagline     String?
  appLogoUrl     String?
  heroHeadline   String?
  heroSubtitle   String?
  playStoreUrl   String?
  appStoreUrl    String?
  announceText   String?
  announceLink   String?
  socialLinks    Json?
  termsOfService String?
  privacyPolicy  String?
  aboutUs        String?
  dmcaEmail      String?
  contactEmail   String? @default("support@comicbd.com")

  // 🛡️ System & Access Controls
  isMaintenanceMode        Boolean @default(false)
  maintenanceMessage       String?
  allowNewRegistrations    Boolean @default(true)
  allowCreatorApplications Boolean @default(true)
  enableGlobalChat         Boolean @default(true)
  enableStripePayment      Boolean @default(true)
  enableCashOut            Boolean @default(true)
  enablePremiumChapters    Boolean @default(true)

  // 🔍 SEO & Web Tracking
  seoTitle       String?
  seoDescription String?
  seoKeywords    String?
  ogImageUrl     String?
  gaTrackingId   String?
  adClient       String?

  // 💰 Economy & Payout Rules
  minWithdrawalPoints        Int      @default(1000)
  creatorRevenueSharePercent Int      @default(70)
  referralBonusPercent       Int      @default(10)
  referralActiveMonths       Int      @default(3)
  referralSignupBonus        Int      @default(50)
  maxDailyAdPoints           Int      @default(1000)
  pointToFiatRate            Float    @default(0.01) // 1 point = $0.01
  featuredRequestFee         Int      @default(500)
  payoutMethods              String[] @default(["bKash", "Nagad", "Rocket", "Bank Transfer"])
  customAdScript             String?
  updatedAt                  DateTime @updatedAt

  @@map("site_config")
}

model Genre {
  id     String   @id @default(uuid())
  name   String   @unique
  series Series[]

  @@map("genre")
}

model Chapter {
  id         String    @id @default(uuid())
  seriesId   String
  series     Series    @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  number     Float
  title      String?
  language   String    @default("en") // e.g. "en", "bn", "es", "hi", etc.
  isLocked   Boolean   @default(false)
  coinCost   Int       @default(0)
  isFastPass Boolean   @default(false)
  publishAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  images     ChapterImage[]
  history    History[]
  purchases  ChapterPurchase[]
  comments   Comment[]
  readEvents ChapterReadEvent[]

  @@unique([seriesId, number, language])
  @@index([seriesId, number(sort: Desc)])
  @@index([seriesId, language])
  @@index([seriesId, createdAt(sort: Desc)])
  @@index([publishAt])
  @@map("chapter")
}

model ChapterImage {
  id        String  @id @default(uuid())
  chapterId String
  chapter   Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  url       String
  order     Int

  @@index([chapterId, order])
  @@map("chapter_image")
}

model Bookmark {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  seriesId  String
  series    Series   @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, seriesId])
  @@index([userId, createdAt(sort: Desc)])
  @@index([seriesId])
  @@map("bookmark")
}

model History {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  seriesId  String
  series    Series   @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  chapterId String
  chapter   Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  updatedAt DateTime @updatedAt

  @@unique([userId, seriesId])
  @@index([userId, updatedAt(sort: Desc)])
  @@index([seriesId])
  @@map("history")
}

model PointTransaction {
  id          String          @id @default(uuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        TransactionType
  amount      Int
  description String
  createdAt   DateTime        @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([type, createdAt(sort: Desc)])
  @@map("point_transaction")
}

model ChapterPurchase {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapterId   String
  chapter     Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  pointsSpent Int
  createdAt   DateTime @default(now())

  @@unique([userId, chapterId])
  @@index([userId, createdAt(sort: Desc)])
  @@index([chapterId])
  @@map("chapter_purchase")
}

model Payment {
  id              String        @id @default(uuid())
  amount          Float
  points          Int
  currency        String        @default("usd")
  status          PaymentStatus @default(PENDING)
  stripeSessionId String?       @unique
  stripePaymentId String?       @unique
  packageId       String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([userId])
  @@map("payment")
}

model PointPackage {
  id        String   @id @default(uuid())
  name      String
  points    Int
  price     Float
  popular   Boolean  @default(false)
  color     String   @default("blue")
  icon      String   @default("Zap")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("point_package")
}

model AdRewardConfig {
  id          String   @id @default(uuid())
  countryCode String[]
  points      Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("ad_reward_config")
}

enum AdProvider {
  CUSTOM
  ADSENSE
  ADMOB
}

enum AdFormat {
  BANNER
  INTERSTITIAL
  REWARDED
  NATIVE
}

enum AdStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

model CustomAd {
  id        String     @id @default(uuid())
  title     String     @default("")
  provider  AdProvider @default(CUSTOM)
  format    AdFormat   @default(BANNER)
  placement String     @default("home_banner") // "home_top" | "home_bottom" | "reader_bottom" | "reader_interstitial" | "rewarded_unlock"

  // Custom Direct Ads
  imageUrl        String?
  linkUrl         String?
  videoUrl        String?
  adType          String  @default("BANNER")
  socialPlatform  String?
  socialActionUrl String?

  // Google AdSense (Web) & Google AdMob (Mobile)
  adClient String? // e.g. "ca-pub-XXXXXXXXXXXXXXXX"
  adSlotId String? // AdSense slot ID
  adUnitId String? // AdMob unit ID

  // Rewards & Performance Tracking
  points          Int      @default(10)
  impressions     Int      @default(0)
  clicks          Int      @default(0)
  revenue         Float    @default(0.0)
  isActive        Boolean  @default(true)
  status          AdStatus @default(ACTIVE)
  targetCountries String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([placement, status])
  @@map("custom_ad")
}

model WithdrawalRequest {
  id              String            @id @default(uuid())
  userId          String
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  pointsRequested Int
  fiatAmount      Float
  bankDetails     String
  paymentMethod   String?
  accountNumber   String?
  status          ApplicationStatus @default(PENDING)
  notes           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@map("withdrawal_request")
}

model Comment {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapterId String
  chapter   Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([chapterId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@map("comment")
}

model Review {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  seriesId  String
  series    Series   @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  rating    Int
  content   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([seriesId, createdAt(sort: Desc)])
  @@index([userId])
  @@map("review")
}

model Report {
  id         String       @id @default(uuid())
  reporterId String
  reporter   User         @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  reason     String
  targetType String
  targetId   String
  status     ReportStatus @default(PENDING)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  series     Series?      @relation(fields: [seriesId], references: [id])
  seriesId   String?

  @@index([status, createdAt(sort: Desc)])
  @@index([targetType, targetId])
  @@map("report")
}

enum FeaturedRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model FeaturedRequest {
  id        String                @id @default(uuid())
  seriesId  String
  series    Series                @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  creatorId String
  creator   User                  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  status    FeaturedRequestStatus @default(PENDING)
  notes     String?
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  @@map("featured_request")
}

model ChatMessage {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String
  imageUrl  String?
  createdAt DateTime @default(now())

  @@map("chat_message")
}

model CreatorPost {
  id        String   @id @default(uuid())
  creatorId String
  creator   User     @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  title     String
  content   String
  imageUrl  String?
  isPinned  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("creator_post")
}

model PromoCode {
  id              String                @id @default(uuid())
  code            String                @unique
  creatorId       String?
  creator         User?                 @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  seriesId        String?
  pointsReward    Int                   @default(0)
  discountPercent Int                   @default(0)
  maxUses         Int                   @default(100)
  usedCount       Int                   @default(0)
  expiresAt       DateTime?
  isActive        Boolean               @default(true)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  redemptions     PromoCodeRedemption[]

  @@map("promo_code")
}

model PromoCodeRedemption {
  id          String    @id @default(uuid())
  promoCodeId String
  promoCode   PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([promoCodeId, userId])
  @@map("promo_code_redemption")
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String
  actor      User     @relation(fields: [actorId], references: [id], onDelete: Cascade)
  action     String
  targetType String
  targetId   String?
  details    Json?
  createdAt  DateTime @default(now())

  @@map("audit_log")
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  subject   String?
  category  String?  @default("General")
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("contact_messages")
}

model ChapterReadEvent {
  id        String          @id @default(uuid())
  sessionId String
  userId    String?
  user      User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  seriesId  String?
  series    Series?         @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  chapterId String?
  chapter   Chapter?        @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  creatorId String?
  creator   CreatorProfile? @relation(fields: [creatorId], references: [id], onDelete: SetNull)

  startedAt          DateTime  @default(now())
  endedAt            DateTime?
  durationSeconds    Int       @default(0)
  pagesViewed        Int       @default(0)
  totalPages         Int       @default(1)
  completionPercent  Float     @default(0.0)
  scrollDepthPercent Float     @default(0.0)
  interactionCount   Int       @default(0)

  qualityTier  QualityTier @default(BOUNCED)
  qualityScore Float       @default(0.0)

  isBotLikely Boolean @default(false)
  botReason   String?
  clientIp    String?
  userAgent   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sessionId, chapterId])
  @@index([createdAt])
  @@index([creatorId, createdAt])
  @@index([seriesId, createdAt])
  @@index([chapterId, createdAt])
  @@index([clientIp, createdAt])
  @@map("chapter_read_event")
}

model RevenueDistributionRun {
  id      String @id @default(uuid())
  adminId String
  admin   User   @relation("AdminDistributionRuns", fields: [adminId], references: [id])

  periodStart DateTime
  periodEnd   DateTime

  grossAmountEntered Float // Exact amount input by Admin (100% creator pool)
  currency           String @default("USD") // "USD" | "POINTS"
  distributablePool  Int // Final points pool distributed

  totalQualityScore   Float
  totalQualifiedReads Int
  totalEngagedReads   Int
  totalCompletedReads Int
  totalCreatorsCount  Int

  status     DistributionStatus @default(COMPLETED)
  revertedAt DateTime?
  revertedBy String? // Admin ID who reverted
  notes      String?

  createdAt DateTime @default(now())

  creatorPayouts RevenueDistributionPayout[]

  @@index([periodStart, periodEnd])
  @@index([status, periodStart, periodEnd])
  @@map("revenue_distribution_run")
}

model RevenueDistributionPayout {
  id                String                 @id @default(uuid())
  distributionRunId String
  distributionRun   RevenueDistributionRun @relation(fields: [distributionRunId], references: [id], onDelete: Cascade)

  creatorId String
  creator   CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  qualityScore    Float
  scorePercentage Float // % of total platform quality

  qualifiedReadsCount Int @default(0)
  engagedReadsCount   Int @default(0)
  completedReadsCount Int @default(0)
  totalReadsCount     Int @default(0)

  pointsAwarded  Int
  fiatEquivalent Float // points * pointToFiatRate

  revertedPoints  Int @default(0)
  shortfallPoints Int @default(0)

  createdAt DateTime @default(now())

  @@unique([distributionRunId, creatorId])
  @@index([creatorId])
  @@map("revenue_distribution_payout")
}
